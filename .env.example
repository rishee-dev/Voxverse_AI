# =============================================================================
# VoxVerse Environment Configuration
# AI-Powered English-to-Telugu Voice Translation Platform
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# All variables are prefixed with VOXVERSE_ to avoid collisions.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Options: development, staging, production
VOXVERSE_ENV=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host to bind the FastAPI server to
VOXVERSE_HOST=127.0.0.1

# Port to bind the FastAPI server to
VOXVERSE_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
VOXVERSE_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Model & Storage Paths
# -----------------------------------------------------------------------------
# Directory where downloaded ML model weights are stored
# Relative paths are resolved from the project root
VOXVERSE_MODEL_DIR=./models

# Root directory for all file storage (audio, voices, temp, output)
VOXVERSE_STORAGE_DIR=./storage

# -----------------------------------------------------------------------------
# Audio Constraints
# -----------------------------------------------------------------------------
# Maximum allowed audio duration in seconds (0 = no limit)
VOXVERSE_MAX_AUDIO_DURATION_SECONDS=300

# Maximum upload file size in megabytes
VOXVERSE_MAX_UPLOAD_SIZE_MB=50

# -----------------------------------------------------------------------------
# Privacy & Consent
# -----------------------------------------------------------------------------
# Whether explicit speaker consent is required before voice cloning
# Set to "true" in production; "false" only for local development/testing
VOXVERSE_SPEAKER_CONSENT_REQUIRED=true

# -----------------------------------------------------------------------------
# External Services (future use — leave blank for MVP)
# -----------------------------------------------------------------------------
# VOXVERSE_SENTRY_DSN=
# VOXVERSE_REDIS_URL=
# VOXVERSE_S3_BUCKET=
